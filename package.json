{
  "name": "vitaliy-profile-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12 <23" },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js",
    "test": "npm run build && node --test dist/test/unit.test.js",
    "test:integration": "npm run build && node --test dist/test/integration.test.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.1.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/graphql": "14.1.0",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.0",
    "graphql": "16.14.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/node": "^22",
    "@types/pg": "^8",
    "prisma": "7.10.1",
    "typescript": "~5.9.3"
  }
}
